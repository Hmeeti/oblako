# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

# Hidden admin panel (obscure URL — change this!)
# Access at: http://localhost:3000/ctl/YOUR_SLUG_HERE
ADMIN_PATH=ctl/x7k9m2p4w4oblako

# Admin credentials — NEVER commit .env with real secrets
ADMIN_USERNAME=hmeeti
# Default password used by START.bat / setup: 9987650
# Generate with: npm run hash-password -- "9987650"
ADMIN_PASSWORD_HASH=

# Optional: OpenAI Vision for accurate dish photo matching
# Without this key, the pipeline uses heuristic + keyword fallback
OPENAI_API_KEY=

# Database path (relative to project root)
DATABASE_PATH=data/oblako.db

# Hybrid hosting (GitHub Pages + Render)
# Comma-separated origins allowed to call public API from the browser
# Example: https://hmeeti.github.io
CORS_ORIGINS=

# Public URL of this API (used to rewrite /image/uploads paths when pushing to GitHub)
PUBLIC_BASE_URL=https://oblako-lppn.onrender.com

# Auto-push js/data.js + js/image-map.js to GitHub after admin edits
# Create token: GitHub → Settings → Developer settings → Personal access tokens
# Permissions: Contents Read and Write on repo Hmeeti/oblako
GITHUB_TOKEN=
GITHUB_REPO=Hmeeti/oblako
GITHUB_BRANCH=main

# SQLite path on Render (ephemeral disk on free plan)
# DATABASE_PATH=data/oblako.db
