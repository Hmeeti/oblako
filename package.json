    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.53.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^12.37.1",
